{
  "name": "iwara-tv-local-player",
  "productName": "IwaraTV",
  "desktopName": "iwaratv.desktop",
  "version": "2.1.1",
  "private": true,
  "description": "Desktop Iwara.tv browser and player.",
  "author": "Demogest",
  "license": "MIT",
  "homepage": "https://github.com/demogest/IwaraTV",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.mts",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node tests/e2e/run-smoke.mjs",
    "check:release": "npm run version:check && npm run typecheck && npm test",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run mpv:update && npm run icons:build && npm run build && electron-builder --win nsis portable zip --x64 --publish never",
    "dist:mac": "npm run icons:build && npm run build && electron-builder --mac dmg --publish never",
    "dist:linux": "npm run icons:build && npm run build && electron-builder --linux deb AppImage --x64 --publish never",
    "pack": "npm run build && electron-builder --dir --publish never",
    "release:win": "npm run check:release && npm run dist:win",
    "version:check": "node scripts/update-version.mjs --check",
    "version:update": "node scripts/update-version.mjs",
    "icons:build": "node scripts/generate-icons.mjs",
    "mpv:update": "node scripts/install-mpv.mjs",
    "update:keygen": "node scripts/update-keygen.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "7zip-bin": "^5.2.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.14.0",
    "playwright-core": "^1.64.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
